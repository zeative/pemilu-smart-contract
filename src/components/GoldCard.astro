---
interface Props {
  name: string;
  image: string;
  number: number;
  rotation?: string;
  delay?: string;
  active?: boolean;
}

const { name, image, number, rotation = "0deg", delay = "0s", active = false } = Astro.props;
---

<div
  class="relative w-[200px] h-[300px] md:w-[240px] md:h-[360px] xl:w-[260px] xl:h-[400px] hover:scale-105 transition-transform cursor-pointer active:scale-100"
  style={`transform: rotate(${rotation});`}
>
  <!-- Card Container -->
  <div class="relative w-full h-full rounded-[16px] overflow-hidden bg-charcoal-900 border border-amber-500/50 shadow-2xl shadow-black/80 backdrop-blur-md">
    <!-- Image Area with Gradient Overlay -->
    <div class="relative h-[85%] w-full overflow-hidden">
      <div class="absolute inset-0 bg-linear-to-t from-[#121212] via-transparent to-transparent z-10"></div>

      <!-- Sepia/Gold Tone Filter on Image -->
      <img src={image} alt={name} class="w-full h-full object-cover object-top scale-110 sepia-[0.3] brightness-90 contrast-110" />
    </div>

    <!-- Content Area with Gradient Background -->
    <div
      class="absolute bottom-0 left-0 right-0 h-[30%] z-20"
      style="background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 50%, transparent 100%);"
    >
      <!-- Candidate Number Badge -->
      <div class="absolute -top-12 right-6">
        <div
          class="w-16 h-16 rounded-full border border-gold-400/30 bg-charcoal-900/90 backdrop-blur-md flex items-center justify-center shadow-[0_0_30px_rgba(251,192,45,0.4)]"
        >
          <span class="font-[Rubik_Distressed] text-3xl text-gold-gradient">{number.toString().padStart(2, "0")}</span>
        </div>
      </div>

      <!-- Centered Name Text -->
      <div class="absolute inset-0 flex items-center justify-center">
        <h3 class="font-[Rubik_Distressed] text-xl text-white tracking-wider uppercase text-center max-w-40">
          {name}
        </h3>
      </div>
    </div>
  </div>
</div>
