---
interface Props {
  name: string;
  image: string;
  number: number;
  rotation?: string;
  delay?: string;
  active?: boolean;
}

const { name, image, number, rotation = "0deg", delay = "0s", active = false } = Astro.props;
---

<div 
  class="group relative w-[200px] h-[300px] md:w-[240px] md:h-[360px] xl:w-[260px] xl:h-[400px] transition-all duration-700 ease-out hover:z-20 hover:scale-105"
  style={`transform: rotate(${rotation}); transition-delay: ${delay};`}
>
  <!-- Card Container -->
  <div class="relative w-full h-full rounded-[16px] overflow-hidden bg-[#121212] border-gold-gradient shadow-gold-glow backdrop-blur-sm">
    
    <!-- Image Area with Gradient Overlay -->
    <div class="relative h-[65%] w-full overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-t from-[#121212] via-transparent to-transparent z-10"></div>
      
      <!-- Sepia/Gold Tone Filter on Image -->
      <img 
        src={image} 
        alt={name} 
        class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-110 sepia-[0.3] brightness-90 contrast-110"
      />
      
      <!-- Scanline/Grid Overlay -->
      <div class="absolute inset-0 bg-[url('/grid-pattern.png')] opacity-10 mix-blend-overlay z-10 pointer-events-none bg-[length:20px_20px]"></div>
    </div>

    <!-- Content Area -->
    <div class="relative h-[35%] px-6 pt-2 pb-6 flex flex-col justify-between z-20">
      
      <!-- Candidate Number Badge -->
      <div class="absolute -top-12 right-6">
        <div class="w-16 h-16 rounded-full border border-gold-400/30 bg-charcoal-900/90 backdrop-blur-md flex items-center justify-center shadow-[0_0_20px_rgba(251,192,45,0.2)] group-hover:shadow-[0_0_30px_rgba(251,192,45,0.4)] transition-shadow duration-300">
           <span class="font-display text-3xl font-bold text-gold-gradient">{number.toString().padStart(2, '0')}</span>
        </div>
      </div>

      <!-- Name and Role -->
      <div class="mt-4">
        <h3 class="font-display text-2xl font-bold text-white tracking-wide uppercase etched-text group-hover:text-gold-gradient transition-colors duration-300">
          {name}
        </h3>
        <div class="h-0.5 w-12 bg-gold-500/50 my-3 group-hover:w-full transition-all duration-500"></div>
        <p class="font-body text-gold-200/60 text-sm tracking-wider uppercase">
          Presidential Candidate
        </p>
      </div>

      <!-- Action Button (Detached look in wireframe, integrated here for cohesion or detached below?) 
           The wireframe shows a detached button below. Let's keep it inside or attached to bottom for now as per "card" logic, 
           but if wireframe has it detached, I will render it OUTSIDE the inner container but inside the wrapper.
      -->
    </div>
  </div>

  <!-- Detached Button Logic (Wireframe style) -->
  <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-[80%] z-30">
    <button class="w-full h-12 rounded-xl bg-charcoal-900 border border-gold-500/30 text-gold-100 font-display text-sm font-bold tracking-widest uppercase hover:bg-gold-500 hover:text-charcoal-950 transition-all duration-300 shadow-lg hover:shadow-gold-glow flex items-center justify-center gap-2 group/btn">
      <span>VOTE NOW</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </button>
  </div>
</div>
