---
interface Props {
  name: string;
  image: string;
  number: number;
  rotation?: string;
  delay?: string;
  active?: boolean;
}

const { name, image, number, rotation = "0deg", delay = "0s", active = false } = Astro.props;
---

<div
  class="group relative w-[200px] h-[300px] md:w-[240px] md:h-[360px] xl:w-[260px] xl:h-[400px] hover:-translate-z-5 duration-500 ease-in-out transition-transform"
  style={`transform: rotate(${rotation}); transition-delay: ${delay};`}
>
  <!-- Cinematic Backlight / Volumetric Glow -->
  <div class="absolute -inset-20 z-[-10] opacity-0 group-hover:opacity-100 transition-opacity duration-1000 ease-in-out">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,theme(colors.amber.500)_0%,transparent_70%)] opacity-30 blur-[80px] mix-blend-screen"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[radial-gradient(ellipse_at_bottom,theme(colors.orange.600)_0%,transparent_70%)] opacity-40 blur-[60px] mix-blend-color-dodge"></div>
  </div>

  <!-- Card Container -->
  <div class="relative w-full h-full rounded-[16px] overflow-hidden bg-[#0a0a0a] border border-white/10 group-hover:border-amber-500/50 shadow-2xl shadow-black/80 transition-colors duration-500 backdrop-blur-md">
    <!-- Image Area with Gradient Overlay -->
    <div class="relative h-[65%] w-full overflow-hidden">
      <div class="absolute inset-0 bg-linear-to-t from-[#121212] via-transparent to-transparent z-10"></div>

      <!-- Sepia/Gold Tone Filter on Image -->
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover object-top scale-110 sepia-[0.3] brightness-90 contrast-110"
      />

      <!-- Scanline/Grid Overlay -->
      <div class="absolute inset-0 bg-[url('/grid-pattern.png')] opacity-10 mix-blend-overlay z-10 pointer-events-none bg-[length:20px_20px]"></div>
    </div>

    <!-- Content Area -->
    <div class="relative h-[35%] px-6 pt-2 pb-6 flex flex-col justify-between z-20">
      <!-- Candidate Number Badge -->
      <div class="absolute -top-12 right-6">
        <div
          class="w-16 h-16 rounded-full border border-gold-400/30 bg-charcoal-900/90 backdrop-blur-md flex items-center justify-center shadow-[0_0_30px_rgba(251,192,45,0.4)] transition-shadow duration-300"
        >
          <span class="font-[Rubik_Distressed] text-3xl text-gold-gradient">{number.toString().padStart(2, "0")}</span>
        </div>
      </div>

      <!-- Name and Role -->
      <div class="mt-4">
        <h3 class="font-[Rubik_Distressed] text-2xl text-white tracking-wider uppercase etched-text group-hover:text-gold-gradient transition-colors duration-300">
          {name}
        </h3>
        <div class="h-0.5 w-12 bg-gold-500/50 my-3 group-hover:w-full transition-all duration-500"></div>
      </div>
    </div>
  </div>
</div>
