---
import Layout from '../layouts/Layout.astro';
import GoldCard from '../components/GoldCard.astro';
import StatsPanel from '../components/StatsPanel.astro';
import Particles from '../components/Particles.astro';

// Placeholder or real image paths
const candidates = [
  { 
    name: "Anies Baswedan", 
    image: "/hero/anies.png", 
    number: 1,
    rotation: "-10deg",
    delay: "0.1s"
  },
  { 
    name: "Prabowo Subianto", 
    image: "/hero/prabowo.png", 
    number: 2,
    rotation: "0deg", 
    delay: "0.2s"
  },
  { 
    name: "Ganjar Pranowo", 
    image: "/hero/ganjar.png", 
    number: 3,
    rotation: "10deg", 
    delay: "0.3s"
  }
];
---

<Layout title="Pemilihan Umum Kohona Blockchain">
  <main class="relative w-full h-dvh flex items-center justify-center overflow-hidden selection:bg-gold-500/30">
    <!-- Main Content Container: h-dvh ensures it fits dynamic viewports -->
    <div class="relative z-10 w-full max-w-[1600px] h-dvh flex flex-col justify-between py-4 px-6 md:py-6 overflow-hidden">
      
      <!-- Header: Compact -->
      <header class="text-center shrink-0 z-20">
        <h1 class="font-display text-2xl md:text-4xl font-bold uppercase tracking-[0.2em] text-gold-gradient drop-shadow-2xl">
          Pemilihan Umum
        </h1>
        <div class="flex items-center justify-center gap-3 mt-2 opacity-80">
          <div class="h-px w-12 md:w-20 bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>
          <span class="font-body text-gold-100 tracking-widest text-[10px] md:text-sm uppercase">Kohona Blockchain</span>
          <div class="h-px w-12 md:w-20 bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>
        </div>
      </header>

      <!-- Cards Container: Flex-1 to take available space, centered -->
      <div class="flex-1 flex items-center justify-center relative perspective-[1500px] w-full min-h-0 py-2">
        
        <!-- Left Shadow Label -->
        <div class="absolute left-4 top-1/2 -translate-y-1/2 hidden 2xl:block pointer-events-none">
           <span class="font-display text-[10px] text-white/10 tracking-[0.5em] -rotate-90 block">OFFICIAL CANDIDATES</span>
        </div>

        <!-- Card Wrapper -->
        <div class="flex items-center justify-center gap-2 md:gap-6 relative z-10 origin-center transition-transform duration-500">
             {candidates.map((candidate) => (
                <GoldCard {...candidate} />
             ))}
        </div>

        <!-- Right Shadow Label -->
         <div class="absolute right-4 top-1/2 -translate-y-1/2 hidden 2xl:block pointer-events-none">
           <span class="font-display text-[10px] text-white/10 tracking-[0.5em] rotate-90 block">SECURE VOTING</span>
        </div>
      </div>

      <!-- Footer / Stats: Compact and Fixed to Bottom visually if needed -->
      <footer class="shrink-0 flex items-center justify-between w-full relative z-20 pt-2">
         <div class="text-[10px] text-slate-500 font-body max-w-xs hidden md:block leading-tight">
            <p>© 2026 Kohona Election Commission.</p>
            <p class="opacity-50">Authorized by the National Committee.</p>
         </div>

         <!-- Stats panel (Horizontal now, no need for heavy scaling) -->
         <div class="origin-bottom-right">
            <StatsPanel />
         </div>
      </footer>

    </div>
  </main>
</Layout>
