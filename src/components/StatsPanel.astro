---
const stats = [
  { label: "Total Votes", value: "24,592,103" },
  { label: "Active Nodes", value: "1,204" },
  { label: "Smart Contract", value: "Verified" },
  { label: "Block Height", value: "#892,102" },
];
---

<div class="rounded-xl bg-charcoal-900/60 backdrop-blur-xl border border-white/5 py-3 px-6 shadow-2xl relative overflow-hidden group z-99999">
  <!-- Glowing border effect -->
  <div class="absolute inset-0 border border-gold-500/20 rounded-xl pointer-events-none"></div>
  
  <!-- Content: Horizontal Layout -->
  <div class="flex items-center gap-6">
    {stats.map((stat, index) => (
      <div class="flex items-center gap-2 border-r border-white/10 pr-6 last:border-0 last:pr-0">
        <span class="font-body text-[10px] text-slate-400 uppercase tracking-wider">{stat.label}</span>
        <span class="font-display text-xs text-gold-100 font-semibold tracking-wide tabular-nums text-shadow-gold whitespace-nowrap">{stat.value}</span>
      </div>
    ))}
  </div>

  <!-- Decorative corner accent -->
  <div class="absolute bottom-0 right-0 w-4 h-4 border-r-2 border-b-2 border-gold-500/50 rounded-br-xl"></div>
</div>
